{
  "name": "@hostelwallet/api",
  "version": "1.0.0",
  "private": true,
  "description": "HostelWallet REST API \u2014 expenses, goals, budgets and AI financial advice for hostel students",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node ../../database/seeds/demo.js",
    "migrate": "node -r dotenv/config src/infrastructure/database/migrate.js",
    "migrate:status": "node -e \"require('./src/infrastructure/database/migrate').status().then(s=>{console.log('applied:',s.applied.map(r=>r.name).join(', ')||'none');console.log('pending:',s.pending.join(', ')||'none')}).finally(()=>require('./src/infrastructure/database/pool').closePool())\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@hostelwallet/contracts": "1.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
