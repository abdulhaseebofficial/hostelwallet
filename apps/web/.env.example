# ─────────────────────────────────────────────────────────────
# HostelWallet — frontend environment variables
# Copy to `.env` (Vite only exposes variables prefixed with VITE_).
# ─────────────────────────────────────────────────────────────

# Where the backend lives.
# Leave it as /api in local development: vite.config.js proxies that to
# http://localhost:5000 so cookies work on a single origin.
# In production set the full URL, e.g. https://hostelwallet-api.onrender.com/api
VITE_API_URL=/api

VITE_APP_NAME=HostelWallet
