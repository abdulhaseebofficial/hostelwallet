{
  "name": "hostelwallet",
  "version": "1.0.0",
  "private": true,
  "description": "HostelWallet - AI-powered financial manager for university hostel students",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @hostelwallet/api\" \"npm run dev -w @hostelwallet/web\"",
    "dev:api": "npm run dev -w @hostelwallet/api",
    "dev:web": "npm run dev -w @hostelwallet/web",
    "build": "npm run build -w @hostelwallet/web",
    "start": "npm start -w @hostelwallet/api",
    "migrate": "npm run migrate -w @hostelwallet/api",
    "migrate:deployed": "node -r dotenv/config apps/api/src/infrastructure/database/migrate.js dotenv_config_path=.env.production.local",
    "migrate:status": "npm run migrate:status -w @hostelwallet/api",
    "test:migrations": "node tests/migrations/fresh-schema.test.js",
    "test:db": "node tests/db/constraints.test.js && node tests/db/debt-transaction.test.js",
    "test:security": "node -r dotenv/config tests/security/pentest.js dotenv_config_path=apps/api/.env",
    "seed": "npm run seed -w @hostelwallet/api",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/api.test.js && node tests/e2e/settings.test.js && node tests/e2e/debts.test.js",
    "qa": "npm run test:e2e",
    "qa:api": "node tests/e2e/api.test.js",
    "qa:settings": "node tests/e2e/settings.test.js",
    "qa:debts": "node tests/e2e/debts.test.js",
    "check": "npm run check:boundaries && npm run check:shadowing && npm run check:dead && npm run test:unit && npm run test:web && npm run test:migrations && npm run test:db && npm run test:e2e && npm run build",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:web": "npm run test -w @hostelwallet/web",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:shadowing": "node scripts/check-shadowing.js",
    "check:dead": "node scripts/find-dead-code.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "student",
    "budget",
    "expense-tracker",
    "postgres",
    "react"
  ],
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
