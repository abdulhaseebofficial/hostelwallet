# ─────────────────────────────────────────────────────────────
# HostelWallet — backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
# IMPORTANT: anything other than "development" or "test" is treated as
# production. Leaving this unset is SAFE - it defaults to production behaviour
# (no stack traces, secure cookies, strict secret checks).
NODE_ENV=development

# Number of reverse proxies in front of the app. Only set this if there IS one:
# trusting X-Forwarded-For without a proxy lets clients spoof their IP and skip
# the per-IP rate limit. Defaults to 1 in production, none in development.
# TRUST_PROXY=1

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# MongoDB — local or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/hostelwallet

# JWT — use long random strings (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Anthropic Claude API — the AI advisor.
# Get a key at https://console.anthropic.com/settings/keys
# If left empty the app still works: it falls back to built-in rule based advice.
ANTHROPIC_API_KEY=

# Preferred model. If your key cannot reach it, the backend automatically tries
# claude-sonnet-5, then claude-haiku-4-5, and only then the built-in advisor -
# so any Anthropic key works without editing this file.
AI_MODEL=claude-opus-5

# Local development only. When SMTP is not configured this returns the raw
# password-reset token in the API response so the flow can be tested. It is an
# account-takeover primitive - never enable it anywhere real.
ALLOW_DEV_RESET_LINK=false

# Optional: password reset e-mail (SMTP). If unset, reset links are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HostelWallet <no-reply@hostelwallet.app>
